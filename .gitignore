# ---------- 备份区：回滚点，不进 git（1GB+ 的样本与旧包）----------
/02_备份/

# ---------- 凭证：绝不入库 ----------
*_token.txt
*.token
.env

# ---------- 构建临时目录（含旧 runtime 备份，体积大且可重建）----------
/runtime_old*/
/runtime_new*/
/tmp/_dist_new*/

# ---------- 运行产物：不进 git（程序可重建、数据属于用户）----------
/runtime/
/runtime_new/
/runtime_old/
/PTW.exe
/version.json
/update_pending.json
/data/
/tmp/
/04_归档/*.zip
/04_归档/*.7z

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------- 打包中间物 ----------
/tmp/buildenv/
/tmp/pyi-build/
/开发/构建/build/
/开发/构建/dist/

# ---------- 编辑/系统 ----------
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*
